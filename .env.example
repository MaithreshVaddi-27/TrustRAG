# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  TRUSTRAG — Environment Variables                                           ║
# ║  Copy this file to .env and fill in real values.                            ║
# ║  NEVER commit .env to version control — it is in .gitignore.               ║
# ║  AI model IDs, thresholds, and tuning params → apps/api/config/models.yaml ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
# Options: development | staging | production
# production disables /docs, /redoc, /openapi.json endpoints

APP_NAME=TRUSTRAG

# LOG_LEVEL options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ─── Security ─────────────────────────────────────────────────────────────────
# REQUIRED. Must be at least 32 characters. Used to sign JWT tokens.
# Generate with:  python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# JWT token expiry in minutes (default: 60 = 1 hour)
JWT_EXPIRY_MINUTES=60

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development:  http://localhost:5173
# Production:   https://your-frontend-domain.com,https://www.your-frontend.com
CORS_ORIGINS=http://localhost:5173

# ─── Multi-Provider AI (Gemini + NVIDIA NIM) ──────────────────────────────────
# Choose active generation & verification provider: 'gemini' or 'nvidia'
AI_PROVIDER=gemini

# Google Gemini API key (Free tier: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY

# NVIDIA NIM API key (Free credits: https://build.nvidia.com)
NVIDIA_API_KEY=

# Optional model overrides:
# For Gemini: gemini-3.5-flash-lite, gemini-2.5-flash, gemini-2.5-pro
# For NVIDIA: meta/llama-3.3-70b-instruct, mistralai/mistral-large-2-instruct, nvidia/llama-3.1-nemotron-70b-instruct
LLM_MODEL=gemini-3.5-flash-lite
VERIFICATION_MODEL=gemini-3.5-flash-lite

# ─── Dense Embeddings (Local BGE vs Cloud Gemini vs NVIDIA) ───────────────────
# Choose embedding engine: 'huggingface' (local offline), 'google_genai', or 'nvidia'
EMBEDDING_PROVIDER=huggingface

# Active Embedding Model:
# Local SOTA: BAAI/bge-small-en-v1.5 (384d, MTEB 62.17, ~32ms query latency, 0 API cost)
# Cloud Gemini: models/gemini-embedding-001 (384d Matryoshka)
# Cloud NVIDIA: nvidia/nv-embedqa-e5-v5
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ─── Web Search Grounding (MCP) ───────────────────────────────────────────────
# Tavily AI Search (1,000 free searches/month at https://tavily.com)
TAVILY_API_KEY=

# Search provider: 'auto', 'tavily', 'duckduckgo' (100% free, zero-key), or 'both'
SEARCH_PROVIDER=auto

# ─── Hugging Face (Optional) ──────────────────────────────────────────────────
# Optional read-only token to prevent hub rate-limits.
# Obtain at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ─── MongoDB Database ─────────────────────────────────────────────────────────
# Option A (Recommended Local): mongodb://localhost:27017
# Option B (MongoDB Atlas Cloud): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=trustrag

# ─── Qdrant Vector Storage ───────────────────────────────────────────────────
# Option A (Recommended Local): local (Embedded RocksDB storage in ./data/qdrant with INT8 quantization)
# Option B (Local Qdrant Server): http://localhost:6333
# Option C (Qdrant Cloud):        https://<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_URL=local

# Leave blank for local embedded Qdrant (no auth required).
# Required only when connecting to managed Qdrant Cloud clusters.
QDRANT_API_KEY=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Requests per minute per IP on the analysis creation endpoint.
RATE_LIMIT_ANALYSES_PER_MINUTE=10

# Requests per minute per IP on auth (login + register) endpoints.
RATE_LIMIT_AUTH_PER_MINUTE=20

