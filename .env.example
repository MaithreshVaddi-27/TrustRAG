# TRUSTRAG — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# All AI model IDs, thresholds, and tuning params belong in config/models.yaml — not here.

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
# LOG_LEVEL options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# JWT token expiry in minutes
JWT_EXPIRY_MINUTES=60

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Development: http://localhost:5173
# Production: https://your-frontend-domain.com
CORS_ORIGINS=http://localhost:5173

# ─── Google Gemini API (free tier) ────────────────────────────────────────────
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY

# ─── Hugging Face (optional but recommended) ──────────────────────────────────
# Prevents rate limits and speeds up downloading embedding models (e.g. all-MiniLM)
# Obtain at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ─── MongoDB Atlas (free M0 cluster) ──────────────────────────────────────────
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb+srv://REPLACE_ME
MONGODB_DATABASE=trustrag_db

# ─── Qdrant ───────────────────────────────────────────────────────────────────
# For local development with Docker: http://localhost:6333 (no API key needed)
# For Qdrant Cloud: https://<cluster-id>.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
# Leave blank for local Qdrant (no auth)
QDRANT_API_KEY=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Requests per minute per IP for the analysis endpoint
RATE_LIMIT_ANALYSES_PER_MINUTE=10
# Requests per minute per IP for auth endpoints
RATE_LIMIT_AUTH_PER_MINUTE=20
