# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  TRUSTRAG — Environment Variables                                           ║
# ║  Copy this file to .env and fill in real values.                            ║
# ║  NEVER commit .env to version control — it is in .gitignore.               ║
# ║  AI model IDs, thresholds, and tuning params → apps/api/config/models.yaml ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
# Options: development | staging | production
# production disables /docs, /redoc, /openapi.json endpoints

APP_NAME=TRUSTRAG

# LOG_LEVEL options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ─── Security ─────────────────────────────────────────────────────────────────
# REQUIRED. Must be at least 32 characters. Used to sign JWT tokens.
# Generate with:  python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# JWT token expiry in minutes (default: 60 = 1 hour)
JWT_EXPIRY_MINUTES=60

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development:  http://localhost:5173
# Production:   https://your-frontend-domain.com,https://www.your-frontend.com
CORS_ORIGINS=http://localhost:5173

# ─── Google Gemini API ────────────────────────────────────────────────────────
# REQUIRED. Free tier available at: https://aistudio.google.com/app/apikey
# Active model is configured in apps/api/config/models.yaml (llm.model)
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY

# ─── Hugging Face (optional but strongly recommended) ─────────────────────────
# Prevents download rate-limits for the sentence-transformer embedding model.
# Obtain at: https://huggingface.co/settings/tokens  (read-only token is enough)
# Leave blank to use anonymous downloads (may be slow on first container start).
HF_TOKEN=

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# REQUIRED. Free M0 cluster available at: https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# For local MongoDB (no Atlas): mongodb://localhost:27017
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER.mongodb.net/
MONGODB_DATABASE=trustrag_db

# ─── Qdrant ───────────────────────────────────────────────────────────────────
# Docker (recommended): the API container connects to Qdrant on the Docker
# internal network. Set QDRANT_URL=http://qdrant:6333 in docker-compose.yml.
# The value below is for running the API locally (outside Docker).
#
# Local (no Docker):   http://localhost:6333
# Qdrant Cloud:        https://<cluster-id>.region.gcp.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333

# Leave blank for local Qdrant (no auth required).
# Required for Qdrant Cloud and required in APP_ENV=production.
QDRANT_API_KEY=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Requests per minute per IP on the analysis creation endpoint.
RATE_LIMIT_ANALYSES_PER_MINUTE=10

# Requests per minute per IP on auth (login + register) endpoints.
RATE_LIMIT_AUTH_PER_MINUTE=20
