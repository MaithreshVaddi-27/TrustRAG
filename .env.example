# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  TRUSTRAG — Environment Variables                                           ║
# ║  Copy this file to .env and fill in real values.                            ║
# ║  NEVER commit .env to version control — it is in .gitignore.               ║
# ║  AI model IDs, thresholds, and tuning params → apps/api/config/models.yaml ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
# Options: development | staging | production
# production disables /docs, /redoc, /openapi.json endpoints

APP_NAME=TRUSTRAG

# LOG_LEVEL options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ─── Security ─────────────────────────────────────────────────────────────────
# REQUIRED. Must be at least 32 characters. Used to sign JWT tokens.
# Generate with:  python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# JWT token expiry in minutes (default: 60 = 1 hour)
JWT_EXPIRY_MINUTES=60

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development:  http://localhost:5173
# Production:   https://your-frontend-domain.com,https://www.your-frontend.com
CORS_ORIGINS=http://localhost:5173

# ─── Google Gemini API & Model Overrides ──────────────────────────────────────
# REQUIRED. Free tier available at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY

# Change or upgrade active models dynamically via environment variables:
# Primary Generation LLM (options: gemini-3.5-flash-lite, gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Claim Verification LLM (zero-temperature structured NLI verifier)
GEMINI_VERIFICATION_MODEL=gemini-3.5-flash-lite

# Dense Embedding Model (options: models/gemini-embedding-001, models/text-embedding-004)
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Embedding Vector Dimensionality (384 for low-RAM Matryoshka MRL, or 768 / 1536)
EMBEDDING_DIM=384

# ─── Hugging Face (Optional) ──────────────────────────────────────────────────
# Only required if using local cross-encoder rerankers or custom Hugging Face models.
# By default, TrustRAG operates with 0 MB GPU RAM using cloud-native Gemini embeddings.
# Obtain at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ─── MongoDB Database ─────────────────────────────────────────────────────────
# Option A (Recommended Local): mongodb://localhost:27017
# Option B (MongoDB Atlas Cloud): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=trustrag

# ─── Qdrant Vector Storage ───────────────────────────────────────────────────
# Option A (Recommended Local): local (Embedded RocksDB storage in ./data/qdrant with INT8 quantization)
# Option B (Local Qdrant Server): http://localhost:6333
# Option C (Qdrant Cloud):        https://<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_URL=local

# Leave blank for local embedded Qdrant (no auth required).
# Required only when connecting to managed Qdrant Cloud clusters.
QDRANT_API_KEY=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Requests per minute per IP on the analysis creation endpoint.
RATE_LIMIT_ANALYSES_PER_MINUTE=10

# Requests per minute per IP on auth (login + register) endpoints.
RATE_LIMIT_AUTH_PER_MINUTE=20

