# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  TRUSTRAG — Secrets & Deployment Endpoints ONLY                           ║
# ║  Copy this file to .env and fill in real values.                          ║
# ║  NEVER commit .env to version control — it is in .gitignore.               ║
# ║                                                                            ║
# ║  Everything else lives in config files (checked into git):                ║
# ║    AI provider + model IDs + thresholds → apps/api/config/models.yaml     ║
# ║    Ports + service base URLs          → config/ports.yaml                 ║
# ║  Rare per-deploy overrides (env wins over both files above):              ║
# ║    AI_PROVIDER, OLLAMA_MODEL, LLAMACPP_MODEL, LLM_MODEL,                   ║
# ║    VERIFICATION_MODEL, EMBEDDING_PROVIDER, EMBEDDING_MODEL, EMBEDDING_DIM,  ║
# ║    OLLAMA_BASE_URL, LLAMACPP_BASE_URL, SEARCH_PROVIDER                     ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ─── Application ──────────────────────────────────────────────────────────────
# APP_ENV: development | staging | production (validated on boot).
# production additionally REQUIRES QDRANT_API_KEY (refused otherwise).
# APP_ENV=development
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO

# ─── Security ─────────────────────────────────────────────────────────────────
# REQUIRED. Must be at least 32 characters. Used to sign JWT tokens.
# Generate with:  python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# JWT lifetime in minutes (default 60). Shorter = smaller stolen-token window.
# JWT_EXPIRY_MINUTES=60

# ─── Deployment ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development:  http://localhost:5173
# Production:   https://your-frontend-domain.com,https://www.your-frontend.com
CORS_ORIGINS=http://localhost:5173

# Optional: only these direct proxy peers may supply X-Forwarded-For/X-Real-IP.
# Empty is safest when clients connect directly to the API.
TRUSTED_PROXY_IPS=

# ─── Provider / model overrides (Optional — env wins over models.yaml) ───────
# Uncomment to pin a deploy without editing config (e.g. staging vs prod).
# AI_PROVIDER=llama_cpp            # ollama | llama_cpp | gemini | nvidia
# EMBEDDING_PROVIDER=huggingface   # huggingface | google_genai | nvidia
# SEARCH_PROVIDER=auto             # auto | tavily | duckduckgo | both
# OLLAMA_MODEL=gemma3:1b
# LLAMACPP_MODEL=LiquidAI/LFM2.5-1.2B-Instruct-GGUF:Q4_K_M
# LLM_MODEL=                      # cloud generation override (gemini/nvidia)
# VERIFICATION_MODEL=             # cloud verification override
# EMBEDDING_MODEL=                # embedding override (must match KB pin!)
# EMBEDDING_DIM=                  # dimensionality override (must match KB pin!)
# Local server endpoints (defaults from config/ports.yaml; override for Docker,
# where the API must reach the host via host.docker.internal):
# OLLAMA_BASE_URL=http://localhost:11434
# LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1

# ─── Rate Limiting (Optional overrides) ──────────────────────────────────────
# Per-client per-minute ceilings (defaults are local-friendly; raise for busy
# production proxies behind a single NAT).
# RATE_LIMIT_ANALYSES_PER_MINUTE=10
# RATE_LIMIT_AUTH_PER_MINUTE=20
# RATE_LIMIT_UPLOAD_PER_MINUTE=10
# RATE_LIMIT_URL_INGEST_PER_MINUTE=10

# ─── Cloud API Keys (Optional — local-first defaults need none) ──────────────
# Google Gemini (only if models.yaml uses gemini: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# NVIDIA NIM (only if models.yaml uses nvidia: https://build.nvidia.com)
NVIDIA_API_KEY=

# Tavily AI Search (1,000 free searches/month at https://tavily.com; else DuckDuckGo)
TAVILY_API_KEY=

# ─── Hugging Face (Optional) ──────────────────────────────────────────────────
# Optional read-only token to prevent hub rate-limits.
# Obtain at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ─── MongoDB Database ─────────────────────────────────────────────────────────
# Option A (Recommended Local): mongodb://localhost:27017
# Option B (MongoDB Atlas Cloud): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=trustrag_db

# ─── Qdrant Vector Storage ────────────────────────────────────────────────────
# Option A (Recommended Local): local (embedded, no server needed)
# Option B (Local Qdrant Server): http://localhost:6333
# Option C (Qdrant Cloud):        https://<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_URL=local

# Leave blank for local embedded Qdrant (no auth required).
# Required only when connecting to managed Qdrant Cloud clusters.
QDRANT_API_KEY=

# ─── Runtime caches (Optional) ─────────────────────────────────────────────────
# Override the directory for the SQLite embedding cache + semantic answer cache.
# Default: apps/api/data/cache  (relative to the repo; see disk_cache.py)
# CACHE_DIR=/var/lib/trustrag/cache

# ─── Local-LLM load guard (Optional) ──────────────────────────────────────────
# Max concurrent generations against the single local Ollama/llama.cpp server.
# Default 1 serializes the ~9 calls/analysis pipeline and prevents timeout
# cascades on -np 2 / queued Ollama. Raise only with a parallel-capable server.
# LOCAL_LLM_MAX_CONCURRENCY=1

# ─── LangSmith Tracing (Optional) ─────────────────────────────────────────────
# Enable LangSmith tracing for LangChain/LangGraph debugging.
# Get key at: https://smith.langchain.com/settings
# LANGSMITH_API_KEY=
# LANGCHAIN_PROJECT=trustrag-api
# LANGCHAIN_TRACING_V2=true

# ─── Ollama server memory tuning (set in the SHELL before `ollama serve`) ────
# These are read by the Ollama server process, NOT by this backend. On ≤8GB
# hosts they are the difference between resident and swappy:
#   export OLLAMA_KV_CACHE_TYPE=q8_0    # halve KV-cache RAM (≈free quality-wise)
#   export OLLAMA_FLASH_ATTENTION=1     # required companion for quantized KV
#   export OLLAMA_MAX_LOADED_MODELS=1   # one resident model (default keeps 3!)
#   export OLLAMA_NUM_PARALLEL=1        # default; NEVER raise on 8GB (KV × N)
#   export OLLAMA_KEEP_ALIVE=5m         # unload idle models; matches backend
# llama.cpp equivalent is automatic: scripts/start_local_llm.sh already passes
# -ctk q8_0 -ctv q8_0 --flash-attn on (see app/core/hardware.py).
