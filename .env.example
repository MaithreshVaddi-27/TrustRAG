# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  TRUSTRAG — Secrets & Deployment Endpoints ONLY                           ║
# ║  Copy this file to .env and fill in real values.                          ║
# ║  NEVER commit .env to version control — it is in .gitignore.               ║
# ║                                                                            ║
# ║  Everything else lives in config files (checked into git):                ║
# ║    AI provider + model IDs + thresholds → apps/api/config/models.yaml     ║
# ║    Ports + service base URLs          → config/ports.yaml                 ║
# ║  Rare per-deploy overrides (env wins over both files above):              ║
# ║    AI_PROVIDER, OLLAMA_MODEL, LLAMACPP_MODEL, MLX_MODEL, LLM_MODEL,        ║
# ║    VERIFICATION_MODEL, EMBEDDING_DIM (or EMBEDDING_DIMENSIONALITY),        ║
# ║    OLLAMA_BASE_URL, LLAMACPP_BASE_URL, MLX_BASE_URL, SEARCH_PROVIDER       ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ─── Application ──────────────────────────────────────────────────────────────
# APP_ENV: development | staging | production (validated on boot).
# production additionally REQUIRES QDRANT_API_KEY (refused otherwise).
# APP_ENV=development
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO

# ─── Security ─────────────────────────────────────────────────────────────────
# REQUIRED. Must be at least 32 characters. Used to sign JWT tokens.
# Generate with:  python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# JWT lifetime in minutes (default 60). Shorter = smaller stolen-token window.
# JWT_EXPIRY_MINUTES=60

# ─── Deployment ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development:  http://localhost:5173
# Production:   https://your-frontend-domain.com,https://www.your-frontend.com
CORS_ORIGINS=http://localhost:5173


# ─── Provider / model overrides (Optional — env wins over models.yaml) ───────
# Uncomment to pin a deploy without editing config (e.g. staging vs prod).
# Accepted aliases (same effect): LLM_PROVIDER=AI_PROVIDER, OLLAMA_HOST=OLLAMA_BASE_URL,
# LLAMA_CPP_MODEL=LLAMACPP_MODEL, LLAMA_CPP_BASE_URL=LLAMACPP_BASE_URL,
# EMBEDDING_DIMENSIONALITY=EMBEDDING_DIM, GEMINI_MODEL=LLM_MODEL,
# GEMINI_VERIFICATION_MODEL=VERIFICATION_MODEL, NIM_API_KEY=NVIDIA_API_KEY,
# LANGCHAIN_API_KEY=LANGSMITH_API_KEY. NOTE: a globally-exported OLLAMA_HOST
# is picked up automatically — unset it if the backend must use another host.
# AI_PROVIDER=llama_cpp            # ollama | llama_cpp | mlx (Apple Silicon) | gemini | nvidia
# SEARCH_PROVIDER=auto             #  tavily
# OLLAMA_MODEL=gemma3:1b
# LLAMACPP_MODEL=LiquidAI/LFM2.5-1.2B-Instruct-GGUF:Q4_K_M
# MLX_MODEL=mlx-community/Llama-3.2-1B-Instruct-4bit   # Apple Silicon only; must match `mlx_lm.server --model`
# LLM_MODEL=                      # cloud generation override (gemini/nvidia)
# VERIFICATION_MODEL=             # cloud verification override
# EMBEDDING_DIM=                  # dimensionality override (must match KB pin!)
# Local server endpoints (defaults from config/ports.yaml; override for Docker,
# where the API must reach the host via host.docker.internal):
# OLLAMA_BASE_URL=http://localhost:11434
# LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
# MLX_BASE_URL=http://127.0.0.1:8090/v1   # separate port so both can run simultaneously
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1   # nvidia provider base (OpenAI-compatible)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1  # alias of NIM_BASE_URL

# ─── Reranker (Optional) ───────────────────────────────────────────────────────
# Empty → models.yaml `reranker:` (int8 ONNX, torch-free). Disable only to fall
# back to the heavier cross-encoder path.
# RERANKER_USE_ONNX=true
# RERANKER_ONNX_MODEL_PATH=                        # empty → models.yaml (fetched once by bootstrap.py)

# ─── Local-LLM performance (Optional — models.yaml `optimization:` defaults) ──
# KV_CACHE_QUANTIZATION=q8_0        # f16|q8_0|q4_0|q4_1 — q8_0 saves 50-75% VRAM
# PROMPT_CACHING=true               # reuse KV cache for static prompt prefixes
# LOCAL_LLM_EARLY_EXIT_EOS=true     # stop at EOS on greedy/single-token batches
# CONTEXT_COMPRESSION_ENABLED=true  # hierarchical summarization before the LLM call
# CONTEXT_COMPRESSION_PROVIDER=      # empty → active LLM provider
# Local-LLM unload guard: drops a resident model after the idle window so a
# long-idle API does not hold VRAM/RAM. Set 0 to keep models warm forever.
# LOCAL_LLM_MODEL_UNLOAD_ENABLED=true

# Tavily AI Search (1,000 free searches/month at https://tavily.com)
TAVILY_API_KEY=

# ─── Cloud API Keys (Optional — local-first defaults need none) ──────────────
# Google Gemini (only if models.yaml uses gemini: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# NVIDIA NIM (only if models.yaml uses nvidia: https://build.nvidia.com)
# Alias NIM_API_KEY also accepted.
NVIDIA_API_KEY=

# ─── Hugging Face (Optional) ──────────────────────────────────────────────────
# Optional read-only token to prevent hub rate-limits.
# Obtain at: https://huggingface.co/settings/tokens
HF_TOKEN=
# Pinned tokenizer revision for ONNX embeddings (Bandit B615 supply-chain
# pin). Only change alongside a fresh `scripts/export_bge_onnx.py` run.
# HF_TOKENIZER_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a

# ─── Verification (Optional) ──────────────────────────────────────────────────
# Fused decompose+verify (one NLI call instead of two). Falls back to the
# classic two-step path automatically; set to 0 to disable unconditionally.
# FUSED_DECOMPOSE_VERIFY=1
# Claim-verification repair attempts before a claim is reported unsupported.
# VERIFICATION_MAX_RETRIES=2

# ─── MongoDB Database ─────────────────────────────────────────────────────────
# Option A (Recommended Local): mongodb://localhost:27017
# Option B (MongoDB Atlas Cloud): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=trustrag_db

# ─── Qdrant Vector Storage ────────────────────────────────────────────────────
# Option A (Recommended Local): local (embedded, no server needed)
# Option B (docker-compose Qdrant): http://localhost:6335
#   (compose maps host 6335 → container 6333; inside compose network use
#   http://qdrant:6333 — already set in docker-compose.yml)
# Option C (Qdrant Cloud):        https://<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_URL=local

# Leave blank for local embedded Qdrant (no auth required).
# Required only when connecting to managed Qdrant Cloud clusters.
QDRANT_API_KEY=

# ─── Runtime caches (Optional) ─────────────────────────────────────────────────
# Override the directory for the SQLite embedding cache + semantic answer cache.
# Default: apps/api/data/cache  (relative to the repo; see disk_cache.py)
# CACHE_DIR=/var/lib/trustrag/cache

# Override where ONNX model weights live (embedding + reranker .onnx files).
# Default: apps/api/.model_cache  (populated once via scripts/bootstrap.py;
# never committed to git). Change only if the volume is too small.
# MODEL_CACHE_DIR=/var/lib/trustrag/models

# Embedding cache TTL (default 30 days). Set to 0 to disable expiration.
# EMBEDDING_CACHE_TTL_SECONDS=2592000
# How often to run cleanup + VACUUM (default 6 hours).
# EMBEDDING_CACHE_CLEANUP_INTERVAL=21600

# Semantic cache TTL (default 24h). Set to 0 to disable.
# SEMANTIC_CACHE_TTL_SECONDS=86400
# Max entries in semantic cache (default 500).
# SEMANTIC_CACHE_MAX_ENTRIES=500
# Max response size to cache (default 20k chars).
# SEMANTIC_CACHE_MAX_RESPONSE_CHARS=20000

# ─── ONNX Runtime (Optional — central defaults in apps/api/config/models.yaml `onnx:`) ──
# One block in models.yaml tunes EVERY ONNX session (embeddings + reranker).
# Env vars below win over yaml — set only what a deploy must pin.
# ONNX_PROVIDERS=CPUExecutionProvider            # comma-separated; GPU hosts: CUDAExecutionProvider,CPUExecutionProvider
# ONNX_INTRA_OP_THREADS=0                        # 0 = auto → min(cpu_count,4); 1-2 for less RAM on ≤8GB
# ONNX_INTER_OP_THREADS=1                        # keep 1 (lowest RAM)
# ONNX_GRAPH_OPTIMIZATION=all                    # none|basic|extended|all
# ONNX_CPU_MEM_ARENA=true                        # false = lower peak RAM on tiny containers, slower warm inference
# ONNX_MEM_PATTERN=true                          # disable together with the arena
# ONNX_EMBED_MICRO_BATCH=0                       # 0 = auto (hardware-tier 32/64/128); >0 forces one size everywhere
# RERANKER_BATCH_SIZE=                            # empty → models.yaml reranker.batch_size (lean tier caps at 8)
# RERANKER_MAX_SEQ_LENGTH=                       # empty → models.yaml reranker.max_seq_length (512)
# ADAPTIVE_TOP_K_THRESHOLD=                      # empty → models.yaml retrieval.adaptive_top_k_threshold (0.02 RRF units)
# ADAPTIVE_TOP_K_CAP=                            # empty → models.yaml retrieval.adaptive_top_k_cap (4)
# RETRIEVAL_BRANCH_TIMEOUT_SECONDS=              # empty → 45s fallback (one hung branch degrades to the other)
# RETRIEVAL_HYBRID_TIMEOUT_SECONDS=              # empty → 60s fallback (both hung = hard outage)
# RETRIEVAL_QUERY_CACHE_CAPACITY=                # empty → models.yaml retrieval.query_cache_capacity (1024)
# QDRANT_UPSERT_BATCH=                           # empty → models.yaml ingestion.qdrant_upsert_batch (100)
# Analysis-wide wall-clock ceiling. Once spent, no new recovery round starts and
# the run abstains rather than guessing. 0 = unbounded (not recommended).
# MAX_ANALYSIS_SECONDS=120

# ─── URL document ingestion (Optional) ──────────────────────────────────────
# SSRF ceiling for ingesting documents from a URL. The shipped default is a
# narrow reference list; a knowledge base is not domain-specific, so add your
# own sources here (comma-separated `scheme://host[:port]`). Narrow host
# matching, the IP blocklist, DNS checks, and size limits all still apply.
# URL_INGEST_ALLOWLIST_EXTRA=https://docs.your-org.example
# OMP_NUM_THREADS=                               # legacy alias honored for intra-op threads when ONNX_INTRA_OP_THREADS=0

# ─── Memory allocator tuning (Optional) ────────────────────────────────────────
# glibc arena limit reduces fragmentation on async FastAPI workloads.
# Set in shell before process start, or in systemd/Docker env.
# MALLOC_ARENA_MAX=1
# TOKENIZERS_PARALLELISM=false  # prevents tokenizer thread-pool bloat next to torch

# ─── Local-LLM load guard (Optional) ──────────────────────────────────────────
# Max concurrent generations against the single local Ollama/llama.cpp server.
# Default 1 serializes the ~9 calls/analysis pipeline and prevents timeout
# cascades on -np 2 / queued Ollama. Raise only with a parallel-capable server.
# LOCAL_LLM_MAX_CONCURRENCY=1


# ─── LangSmith Tracing (Optional) ─────────────────────────────────────────────
# Enable LangSmith tracing for LangChain/LangGraph debugging.
# Get key at: https://smith.langchain.com/settings
# LANGSMITH_API_KEY=
# LANGCHAIN_PROJECT=trustrag-api
# LANGCHAIN_TRACING_V2=true

# ─── Ollama server memory tuning (set in the SHELL before `ollama serve`) ────
# These are read by the Ollama server process, NOT by this backend. On ≤8GB
# hosts they are the difference between resident and swappy:
#   export OLLAMA_KV_CACHE_TYPE=q8_0    # halve KV-cache RAM (≈free quality-wise)
#   export OLLAMA_FLASH_ATTENTION=1     # required companion for quantized KV
#   export OLLAMA_MAX_LOADED_MODELS=1   # one resident model (default keeps 3!)
#   export OLLAMA_NUM_PARALLEL=1        # default; NEVER raise on 8GB (KV × N)
#   export OLLAMA_KEEP_ALIVE=5m         # unload idle models; matches backend
# llama.cpp equivalent is automatic: scripts/start_local_llm.sh already passes
# -ctk q8_0 -ctv q8_0 --flash-attn on (see app/core/hardware.py).
