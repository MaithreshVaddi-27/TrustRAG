# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  TRUSTRAG — Environment Variables                                           ║
# ║  Copy this file to .env and fill in real values.                            ║
# ║  NEVER commit .env to version control — it is in .gitignore.               ║
# ║  AI model IDs, thresholds, and tuning params → apps/api/config/models.yaml ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
# Options: development | staging | production
# production disables /docs, /redoc, /openapi.json endpoints

APP_NAME=TRUSTRAG

# LOG_LEVEL options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ─── Security ─────────────────────────────────────────────────────────────────
# REQUIRED. Must be at least 32 characters. Used to sign JWT tokens.
# Generate with:  python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# JWT token expiry in minutes (default: 60 = 1 hour)
JWT_EXPIRY_MINUTES=60

# Tokens carry a unique jti claim. POST /auth/logout revokes the token server-side
# (MongoDB denylist with TTL index) so it can never be reused after sign-out.

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development:  http://localhost:5173
# Production:   https://your-frontend-domain.com,https://www.your-frontend.com
CORS_ORIGINS=http://localhost:5173

# ─── Multi-Provider AI (Ollama + llama.cpp + Gemini + NVIDIA NIM) ─────────────
# Choose active generation & verification provider: 'ollama', 'llama_cpp', 'gemini', or 'nvidia'
AI_PROVIDER=ollama

# ── Local Ollama (Zero API keys needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# ── Local llama.cpp (Zero API keys needed, OpenAI-compatible server)
LLAMACPP_BASE_URL=http://localhost:8081/v1
LLAMACPP_MODEL=gemma-4-E2B-it-qat-q4_0-gguf:Q4_0

# ── Cloud Providers (Optional)
# Google Gemini API key (Optional if using Ollama/llama.cpp: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# NVIDIA NIM API key (Optional: https://build.nvidia.com)
NVIDIA_API_KEY=

# Optional model overrides:
# For Ollama:    gemma4:e2b, llama3.2:latest, mistral, qwen2.5
# For llama.cpp: gemma-4-E2B-it-qat-q4_0-gguf:Q4_0, meta/llama-3.2-3b
# For Gemini:    gemini-3.5-flash-lite, gemini-2.5-flash
# For NVIDIA:    meta/llama-3.3-70b-instruct
LLM_MODEL=gemma4:e2b
VERIFICATION_MODEL=gemma4:e2b

# ─── Dense Embeddings (Local BGE vs Local Ollama vs Cloud) ──────────────────
# Choose embedding engine: 'huggingface' (local offline), 'ollama' (local offline), 'google_genai', or 'nvidia'
EMBEDDING_PROVIDER=huggingface

# Active Embedding Model:
# Local HuggingFace: BAAI/bge-small-en-v1.5 (384d, MTEB 62.17, ~32ms latency, 0 API cost)
# Local Ollama:      embeddinggemma:300m-qat-q8_0 (768d, discovered via `ollama list`)
# Cloud Gemini:      models/gemini-embedding-001 (384d Matryoshka)
# Cloud NVIDIA:      nvidia/nv-embedqa-e5-v5 (384d)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Optional: override the embedding model per-provider without touching models.yaml.
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ─── Web Search Grounding (MCP) ───────────────────────────────────────────────
# Tavily AI Search (1,000 free searches/month at https://tavily.com)
TAVILY_API_KEY=

# Search provider: 'auto', 'tavily', 'duckduckgo' (100% free, zero-key), or 'both'
SEARCH_PROVIDER=auto

# ─── Hugging Face (Optional) ──────────────────────────────────────────────────
# Optional read-only token to prevent hub rate-limits.
# Obtain at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ─── MongoDB Database ─────────────────────────────────────────────────────────
# Option A (Recommended Local): mongodb://localhost:27017
# Option B (MongoDB Atlas Cloud): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=trustrag

# ─── Qdrant Vector Storage ───────────────────────────────────────────────────
# Option A (Recommended Local): local (Embedded RocksDB storage in ./data/qdrant with INT8 quantization)
# Option B (Local Qdrant Server): http://localhost:6333
# Option C (Qdrant Cloud):        https://<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_URL=local

# Leave blank for local embedded Qdrant (no auth required).
# Required only when connecting to managed Qdrant Cloud clusters.
QDRANT_API_KEY=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Requests per minute per IP on the analysis creation endpoint.
RATE_LIMIT_ANALYSES_PER_MINUTE=10

# Requests per minute per IP on auth endpoints (register + login + logout).
RATE_LIMIT_AUTH_PER_MINUTE=20

