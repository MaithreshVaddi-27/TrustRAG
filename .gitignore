# ─── Docker ───────────────────────────────────────────────────────────────────
.docker/
# Local compose overrides (personal ports/volumes) must never be committed.
docker-compose.override.yml
docker-compose.override.yaml

# ─── Runtime data (Qdrant collections, caches, model snapshots) ────────────────
data/
apps/api/data/
qdrant_storage/

# ─── ML / Model cache (sentence-transformers, HuggingFace Hub, GGUF) ──────────
# Model weights are NEVER committed — every machine fetches them once via
# scripts/bootstrap.py into apps/api/.model_cache/ (override: MODEL_CACHE_DIR).
.cache/
.cache/huggingface/
.model_cache/
apps/api/.model_cache/
models/
*.bin
*.pt
*.ckpt
*.safetensors
*.gguf
*.onnx
*.onnx.data
*.llamafile
llama-server.log
.huggingface/

# Local-LLM launcher output (scripts/start_local_llm.sh, start_mlx_server.sh)
*.mlx.server.log
mlx-server.log
mlx_lm.server.log
# Legacy SQLite cache dir — the embedding/answer cache was removed; kept so a
# stale dev DB on someone's machine is never committed.
apps/api/data/cache/

# ─── Security scan output ─────────────────────────────────────────────────────
bandit-report.json
safety-report.json
trivy-report.json
trivy-results.sarif
semgrep-report.json
pip-audit-report.json
# pip-audit's DEFAULT output format is report.html (security.yml runs it unflagged).
report.html

# ─── Package manager lockfiles ────────────────────────────────────────────────
# apps/web uses npm (package-lock.json is committed)
# apps/api uses uv — uv.lock IS committed (the API Dockerfile does `uv sync --locked`)
bun.lockb
uv.lock
!apps/api/uv.lock

# ─── AI / Agentic tool directories ────────────────────────────────────────────
.agents/
.aider*
.continue/
*.aider.chat.history.md

# ─── Jupyter / notebooks (if ever used for evaluation) ────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Runtime / process files ──────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock
.python-version
.tool-versions

# ─── Temporary / Scratch files ────────────────────────────────────────────────
*.tmp
*.bak
*.orig
*.rej
test.txt
test_*.txt
.superpowers/

# ─── Agent memory & machine-local dirs ────────────────────────────────────────
.remember/
# Project-id/credential scratch dirs written by external CLIs into the repo root.
.freebuff/

# ─── Env-tool locals ─────────────────────────────────────────────────────────
.envrc

# ─── SQLite runtime caches (embedding disk cache, etc.) ───────────────────────
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db
*.db-wal
*.db-shm
*.rdb

# ─── Evaluation run artifacts (runner JSON output; methodology stays tracked) ──
docs/evaluation/results/

# ─── k6 / load-test raw output ────────────────────────────────────────────────
load-test/*.har
load-test/results/

