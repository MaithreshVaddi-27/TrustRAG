# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  TRUSTRAG Web Frontend — Environment Configuration                           ║
# ║  Set in Cloudflare Pages Dashboard under Environment Variables               ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# Remote Backend API URL (for production/Cloudflare Pages deployment)
# Example: https://trustrag-api.onrender.com
# During local development, leave this empty to use Vite's built-in dev proxy.
VITE_API_URL=

# Local Backend Port (default is 8080)
VITE_BACKEND_PORT=8080
