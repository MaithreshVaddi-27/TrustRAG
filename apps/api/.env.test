# ─── Test environment (committed, SYNTHETIC values only) ─────────────────────
# Loaded by apps/api/tests/conftest.py with override=True so the suite is
# hermetic: a developer's real .env or an exported shell key can NEVER leak in
# and make results machine-dependent.
#
# NEVER put a real credential in this file. Every value below is a
# format-valid dummy used only to satisfy Settings construction and to assert
# that secrets are redacted / never logged. Rotate nothing here; there is
# nothing real to rotate.
#
# CI: export nothing — this file is the single source of test config.

# ── Required (Settings construction fails without these) ─────────────────────
JWT_SECRET=test-secret-minimum-32-characters-long-key-for-unit-testing
MONGODB_URI=mongodb://localhost:27017

# ── Optional providers: present but non-functional ────────────────────────────
# Set so code paths that check "is a key configured?" take the same branch on
# every machine. Any request made with these fails fast, as it should.
GEMINI_API_KEY=test-gemini-api-key
TAVILY_API_KEY=test-tavily-api-key
QDRANT_API_KEY=test-qdrant-api-key

# ── Service endpoints ────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
CORS_ORIGINS=http://localhost:5173
APP_ENV=development

# ── Test-isolation paths ─────────────────────────────────────────────────────
# Never let tests write into the real data directories.
PAGE_IMAGES_DIR=data/test_page_images
MODEL_CACHE_DIR=.model_cache